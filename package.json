{
  "name": "goalflow",
  "version": "1.0.0",
  "private": true,
  "description": "GoalFlow \u2014 local-first task, goal and time management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p scripts",
    "test": "esbuild scripts/smoke-test.ts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --external:vue --outfile=node_modules/.cache/smoke-test.mjs --log-level=warning && node node_modules/.cache/smoke-test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TatianaMityagina/GoalFlow.git"
  },
  "license": "ISC",
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
